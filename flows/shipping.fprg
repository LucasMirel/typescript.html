<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="shipping"/>
        <attribute name="authors" value="MUHAMMAD AYDIN"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-08 11:01:36 PM"/>
        <attribute name="created" value="TVVIQU1NQUQgQVlESU47TEFQVE9QLUZPTlJKSlBUOzIwMjYtMDgtMDM7MTA6MzQ6MzggQU07MzM5MA=="/>
        <attribute name="edited" value="TVVIQU1NQUQgQVlESU47TEFQVE9QLUZPTlJKSlBUOzIwMjYtMDktMDg7MTE6MDE6MzYgUE07MjszNTEz"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="name, product" type="String" array="False" size=""/>
            <declare name="price, quantity, subtotal, ship, total" type="Real" array="False" size=""/>
            <output expression="&quot;Enter Customer Name : &quot;" newline="True"/>
            <input variable="name"/>
            <output expression="&quot;Enter Product Name : &quot;" newline="True"/>
            <input variable="product"/>
            <output expression="&quot;Enter Product Price : &quot;" newline="True"/>
            <input variable="price"/>
            <output expression="&quot;Enter Item Quantity : &quot;" newline="True"/>
            <input variable="quantity"/>
            <output expression="&quot;Enter Shipping Fee : &quot;" newline="True"/>
            <input variable="ship"/>
            <assign variable="subtotal" expression="(price*quantity)"/>
            <assign variable="total" expression="(subtotal*quantity)"/>
            <output expression="&quot;=== ONLINE INVOICE ===&quot;&#13;&#10;&amp;&#13;&#10;toChar(13)&#13;&#10;&amp;&#13;&#10;toChar(13)&#13;&#10;&amp;&#13;&#10;&quot;Customer Name : &quot;&amp;name&#13;&#10;&amp;&#13;&#10;toChar(13)&#13;&#10;&amp;&#13;&#10;&quot;Product Name : &quot;&amp;product&#13;&#10;&amp;&#13;&#10;toChar(13)&#13;&#10;&amp;&#13;&#10;&quot;Item Price : &quot;&amp;price&#13;&#10;&amp;&#13;&#10;toChar(13)&#13;&#10;&amp;&#13;&#10;&quot;Item Quantity : &quot;&amp;quantity&#13;&#10;&amp;&#13;&#10;toChar(13) &#13;&#10;&amp;&#13;&#10;toChar(13)&#13;&#10;&amp;&#13;&#10;&quot;Subtotal : &quot;&amp;subtotal&#13;&#10;&amp;&#13;&#10;toChar(13)&#13;&#10;&amp;&#13;&#10;&quot;Shipping Fee : &quot;&amp;ship&#13;&#10;&amp;&#13;&#10;toChar(13)&#13;&#10;&amp;&#13;&#10;&quot;Grand total :&quot;&amp;total" newline="True"/>
        </body>
    </function>
</flowgorithm>
