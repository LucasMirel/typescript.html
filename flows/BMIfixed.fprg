<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="BMIfixed"/>
        <attribute name="authors" value="MUHAMMAD AYDIN"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-08 10:24:30 PM"/>
