<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="discount"/>
        <attribute name="authors" value="MUHAMMAD AYDIN"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-07 01:30:21 PM"/>
        <attribute name="created" value="TVVIQU1NQUQgQVlESU47TEFQVE9QLUZPTlJKSlBUOzIwMjYtMDktMDc7MDE6MDE6MzMgUE07MzM5OQ=="/>
        <attribute name="edited" value="TVVIQU1NQUQgQVlESU47TEFQVE9QLUZPTlJKSlBUOzIwMjYtMDktMDc7MDE6MzA6MjEgUE07MTszNTA2"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="name, member, discount" type="String" array="False" size=""/>
            <declare name="total, cost" type="Real" array="False" size=""/>
            <output expression="&quot;Enter Customer Name : &quot;" newline="True"/>
            <input variable="name"/>
            <output expression="&quot;Enter Membership Type : &quot;" newline="True"/>
            <input variable="member"/>
            <output expression="&quot;Enter Item Cost :&quot;" newline="True"/>
            <input variable="cost"/>
            <if expression="(member=&quot;Gold&quot; Or member=&quot;Reguler&quot;)And cost&lt;=100000">
                <then>
                    <if expression="(member=&quot;Gold&quot;)==true">
                        <then>
                            <assign variable="discount" expression="&quot;20%&quot;"/>
                            <assign variable="total" expression="(cost*0.2)"/>
                        </then>
                        <else>
                            <assign variable="discount" expression="&quot;10%&quot;"/>
                            <assign variable="total" expression="(cost*0.1)"/>
                        </else>
                    </if>
                    <output expression="&quot;=== MEMBERSHIP DISCOUNT SYSTEM ===&quot;&#13;&#10;&amp;&#13;&#10;toChar(13)&#13;&#10;&amp;&#13;&#10;&quot;Customer Name : &quot;&amp;name&#13;&#10;&amp;&#13;&#10;toChar(13)&#13;&#10;&amp;&#13;&#10;&quot;Membership Type : &quot;&amp;member&#13;&#10;&amp;&#13;&#10;toChar(13)&#13;&#10;&amp;&#13;&#10;&quot;Total Purchase : &quot;&amp;cost&#13;&#10;&amp;&#13;&#10;toChar(13)&#13;&#10;&amp;&#13;&#10;toChar(13)&#13;&#10;&amp;&#13;&#10;&quot;Discount Applied : &quot;&amp;discount&#13;&#10;&amp;&#13;&#10;toChar(13)&#13;&#10;&amp;&#13;&#10;&quot;Final Price : &quot;&amp;total" newline="True"/>
                </then>
                <else>
                    <assign variable="total" expression="cost"/>
                    <output expression="&quot;=== MEMBERSHIP DISCOUNT SYSTEM ===&quot;&#13;&#10;&amp;&#13;&#10;toChar(13)&#13;&#10;&amp;&#13;&#10;&quot;Customer Name : &quot;&amp;name&#13;&#10;&amp;&#13;&#10;toChar(13)&#13;&#10;&amp;&#13;&#10;&quot;Membership Type : &quot;&amp;member&#13;&#10;&amp;&#13;&#10;toChar(13)&#13;&#10;&amp;&#13;&#10;&quot;Total Purchase : &quot;&amp;cost&#13;&#10;&amp;&#13;&#10;toChar(13)&#13;&#10;&amp;&#13;&#10;toChar(13)&#13;&#10;&amp;&#13;&#10;&quot;Discount Applied : 0%&quot;&#13;&#10;&amp;&#13;&#10;toChar(13)&#13;&#10;&amp;&#13;&#10;&quot;Final Price : &quot;&amp;total" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
