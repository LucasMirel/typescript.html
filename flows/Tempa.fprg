    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="F" type="Integer" array="False" size=""/>
            <declare name="C" type="Integer" array="False" size=""/>
            <output expression="&quot;=== Temperature Converter ===&quot;" newline="True"/>
            <output expression="&quot;Enter Temperature (C) : &quot;" newline="True"/>
            <input variable="C"/>
            <assign variable="f" expression="9/5*C+32"/>
            <output expression="&quot;=== Temperature Converter ===&quot;&#13;&#10;&amp;&#13;&#10;toChar(13)&#13;&#10;&amp;&#13;&#10;toChar(13)&#13;&#10;&amp;&#13;&#10;&quot;Temperature (C) : &quot;&amp;C&amp;&quot;c&quot;&#13;&#10;&amp;&#13;&#10;toChar(13)&#13;&#10;&amp;&#13;&#10;&quot;Temperature (F) : &quot;&amp;F&amp;&quot;f&quot;" newline="True"/>
        </body>
